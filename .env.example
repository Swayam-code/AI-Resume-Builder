# Browser-safe Clerk publishable key only; never put service secrets in VITE_ variables.
VITE_CLERK_PUBLISHABLE_KEY=
# Exact frontend origin. Use http://localhost:3000 with `vercel dev` locally.
APP_ORIGIN=https://your-app.example
# Clerk instance issuer, for example https://your-instance.clerk.accounts.dev
CLERK_ISSUER=
CLERK_SECRET_KEY=
# HTTPS Strapi origin with trailing slash; no /api suffix.
STRAPI_BASE_URL=https://your-strapi.example/
STRAPI_API_KEY=
GEMINI_API_KEY=
# Choose a currently supported generateContent model in your Google account.
GEMINI_MODEL=
